<?xml version="1.0" encoding="utf-8"?>
<!-- 55 % vehículo multicapa | 45 % widgets (mapa arriba; música y velocímetro abajo).
     Porcentajes con Guidelines: se adapta a 1024x600, 1280x720 y 1920x1080 sin layouts distintos. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/gap">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gVehicle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.775" />

    <!-- ===== Barra lateral: CarPlay (ZLink) y logo del instalador ===== -->
    <LinearLayout
        android:id="@+id/sideBar"
        android:layout_width="@dimen/side"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btnCarPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/carplay"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/carplay_bg"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_carplay" />

            <TextView
                android:id="@+id/carPlayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/carplay"
                android:textSize="10sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/dockLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:padding="2dp"
            android:src="@drawable/ic_cargo" />
    </LinearLayout>

    <!-- ===== Vehículo: carretera HUD + carro ===== -->
    <FrameLayout
        android:id="@+id/vehiclePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginEnd="@dimen/gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gVehicle"
        app:layout_constraintStart_toEndOf="@id/sideBar"
        app:layout_constraintTop_toTopOf="parent">

        <com.cargo.launcher.RoadHudView
            android:id="@+id/roadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/carImage"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@string/car"
            android:scaleType="fitCenter" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:textSize="@dimen/clock" />

        <TextView
            android:id="@+id/obdStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- ===== Mapa ===== -->
    <FrameLayout
        android:id="@+id/mapCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/gap"
        app:layout_constraintBottom_toTopOf="@id/gMap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/gVehicle"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:text="@string/nav"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/map_hint"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- ===== Música ===== -->
    <LinearLayout
        android:id="@+id/mediaCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/gap"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gMedia"
        app:layout_constraintStart_toEndOf="@id/gVehicle"
        app:layout_constraintTop_toBottomOf="@id/gMap">

        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="@dimen/art"
            android:layout_height="@dimen/art"
            android:contentDescription="@string/art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cargo" />

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/no_music"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/MediaButton"
                android:contentDescription="@string/prev"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/btnPlay"
                style="@style/MediaButton"
                android:contentDescription="@string/play"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/MediaButton"
                android:contentDescription="@string/next"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Velocímetro digital + telemetría OBD2 ===== -->
    <LinearLayout
        android:id="@+id/speedCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/gMedia"
        app:layout_constraintTop_toBottomOf="@id/gMap">

        <TextView
            android:id="@+id/speedValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-thin"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/no_value" />

        <TextView
            android:id="@+id/speedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/rpmBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="7000" />

        <TextView
            android:id="@+id/rpmText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/coolantText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/voltText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
