<?xml version="1.0" encoding="utf-8"?>
<!--
  Viewport del vehículo (55 % izquierdo). Capas en orden Z (la primera queda al fondo):
    1. ivSceneDay        escenario de día (degradado cálido)
       vpRoad            carretera dibujada en código, solo de día
    2. ivRoadBackground  asset de la carretera nocturna en diagonal hacia el horizonte con la línea
                         de carril tenue. Hay uno por auto: la carretera sigue la dirección del auto.
       ivRoadOverlay     viñeta que funde las orillas con el fondo negro
    3. ivHeadlightBeam   conos de luz translúcidos sobre el asfalto frente a los faros (solo noche)
       ivReflection      reflejo del auto en el asfalto mojado (solo noche)
       ivCarShadow       sombra de contacto bajo las llantas
    4. ivVehicleModel    el auto (fitCenter), apoyado sobre el carril
       ivVehicleModelNext  segunda capa para cambiar de auto con crossfade, sin parpadeo
    5. ivLampGlow        destello de los faros encima del auto (solo noche)
  VehicleViewport coloca todo con porcentajes del contenedor y alinea la carretera con las llantas.
-->
<com.cargo.launcher.viewport.VehicleViewport xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vehicleViewportContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090D"
    android:clipChildren="true">

    <ImageView
        android:id="@+id/ivSceneDay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/vp_scene_day" />

    <com.cargo.launcher.viewport.PerspectiveRoadView
        android:id="@+id/vpRoad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/ivRoadBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="matrix" />

    <ImageView
        android:id="@+id/ivRoadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_road_overlay" />

    <com.cargo.launcher.viewport.HeadlightBeamView
        android:id="@+id/ivHeadlightBeam"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/ivReflection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleY="-1" />

    <ImageView
        android:id="@+id/ivCarShadow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/ivVehicleModel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/car"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/ivVehicleModelNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <com.cargo.launcher.viewport.HeadlightBeamView
        android:id="@+id/ivLampGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible" />

</com.cargo.launcher.viewport.VehicleViewport>
