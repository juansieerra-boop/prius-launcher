<?xml version="1.0" encoding="utf-8"?>
<!-- Dock lateral: negro mate continuo con una línea fina a la derecha -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0D12" />
        </shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
