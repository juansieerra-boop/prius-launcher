<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/screen_pad">

        <!-- ===== Tarjeta izquierda: reloj, carro, velocidad y mapa ===== -->
        <RelativeLayout
            android:id="@+id/leftCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="626"
            android:background="@drawable/card_bg">

            <com.juandiego.priuslauncher.StripesView
                android:id="@+id/stripes"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.juandiego.priuslauncher.CarPhotoView
                android:id="@+id/carPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/bottomRow"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/photo_top"
                android:layout_marginBottom="4dp"
                android:longClickable="true" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text_main"
                android:textSize="@dimen/clock_size"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/clock"
                android:layout_alignParentStart="true"
                android:layout_marginStart="23dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/date_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/round_button_bg"
                android:contentDescription="@string/settings_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tune"
                android:tint="@color/text_soft" />

            <LinearLayout
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="2dp"
                android:layout_toStartOf="@id/btnSettings"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.18"
                    android:text="@string/brand_title"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.3"
                    android:text="@string/brand_sub"
                    android:textColor="@color/text_dim"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gpsPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/brand"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/gpsDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/circle_bg" />

                <TextView
                    android:id="@+id/gpsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Fila de abajo: velocidad + mapa -->
            <LinearLayout
                android:id="@+id/bottomRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_row_h"
                android:layout_alignParentBottom="true"
                android:layout_margin="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/speedTile"
                    android:layout_width="@dimen/speed_w"
                    android:layout_height="match_parent"
                    android:background="@drawable/dark_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/speed_size"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/speedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.2"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.juandiego.priuslauncher.SegmentBar
                        android:id="@+id/speedBar"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/mapTile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/dark_tile_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:longClickable="true">

                    <com.juandiego.priuslauncher.MapTileView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="@drawable/label_bg"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/maps_label"
                        android:textColor="@color/text_main"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/label_bg"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/maps_hint"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- ===== Columna derecha ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="358"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/phoneBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bar_h"
                android:background="@drawable/tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:id="@+id/phoneIconBox"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/accent_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_smartphone"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/connect_phone"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_dim"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileRow1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/tileRow2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/allApps"
                android:layout_width="match_parent"
                android:layout_height="@dimen/all_h"
                android:layout_marginTop="@dimen/gap"
                android:background="@drawable/tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/text_soft" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/all_apps"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Música -->
            <LinearLayout
                android:id="@+id/mediaCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="2.4"
                android:background="@drawable/tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/media_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/artBox"
                        android:layout_width="@dimen/art_size"
                        android:layout_height="@dimen/art_size">

                        <ImageView
                            android:id="@+id/artIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music"
                            android:tint="#FFFFFFFF" />

                        <ImageView
                            android:id="@+id/albumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nowCap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.2"
                            android:text="@string/now_playing"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/trackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/trackArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.juandiego.priuslauncher.ProgressLine
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/posText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/durText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="@dimen/ctrl_size"
                        android:layout_height="@dimen/ctrl_size"
                        android:background="@drawable/round_button_bg"
                        android:contentDescription="@string/prev"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev"
                        android:tint="@color/text_main" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="@dimen/play_size"
                        android:layout_height="@dimen/play_size"
                        android:layout_marginStart="36dp"
                        android:layout_marginEnd="36dp"
                        android:background="@drawable/circle_bg"
                        android:contentDescription="@string/play_pause"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:tint="#FFFFFFFF" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="@dimen/ctrl_size"
                        android:layout_height="@dimen/ctrl_size"
                        android:background="@drawable/round_button_bg"
                        android:contentDescription="@string/next"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        android:tint="@color/text_main" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
