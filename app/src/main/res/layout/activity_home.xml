<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio (Art y Sport).
     Arriba a la izquierda: hora, clima, Wi-Fi/BT y velocidad. El carro en grande.
     A la derecha: música y navegación con el mapa chico. Abajo: la barra con nombres.
     En Sport, MainActivity reacomoda la columna (mapa arriba) y pinta los tags a1/a2/a3 con tu color. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- El carro -->
            <FrameLayout
                android:id="@+id/carArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginTop="@dimen/car_top"
                android:layout_marginEnd="@dimen/right_w"
                android:paddingEnd="@dimen/gap"
                android:paddingBottom="6dp">

                <com.juandiego.priuslauncher.CarPhotoView
                    android:id="@+id/carPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:longClickable="true" />
            </FrameLayout>

            <!-- Viaje (solo Sport) -->
            <TextView
                android:id="@+id/tripLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.06"
                android:singleLine="true"
                android:tag="a2"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Arriba a la izquierda -->
            <LinearLayout
                android:id="@+id/topLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/clockTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="H:mm"
                        android:includeFontPadding="false"
                        android:tag="a1"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/clock" />

                    <TextClock
                        android:id="@+id/clockAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:tag="a2"
                        android:textColor="@color/text_main"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statusRow"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sun"
                        android:tag="a2"
                        android:tint="@color/text_muted" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="a2"
                        android:text="--°"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxWidth="150dp"
                        android:singleLine="true"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/gpsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="GPS ●"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/statusWifi"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/chip_bg"
                        android:contentDescription="@string/wifi"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_wifi" />

                    <ImageButton
                        android:id="@+id/statusBt"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:background="@drawable/chip_bg"
                        android:contentDescription="@string/bluetooth"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_bt" />

                    <ImageButton
                        android:id="@+id/btnDayNight"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:background="@drawable/chip_bg"
                        android:contentDescription="@string/day_night"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sun"
                        android:tint="@color/text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/speedRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:tag="a1"
                        android:text="0"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/speed_art" />

                    <TextView
                        android:id="@+id/speedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.15"
                        android:tag="a2"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Columna derecha: música y navegación -->
            <LinearLayout
                android:id="@+id/rightCol"
                android:layout_width="@dimen/right_w"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/float_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/mediaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_playing"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/artBox"
                            android:layout_width="@dimen/thumb"
                            android:layout_height="@dimen/thumb">

                            <ImageView
                                android:id="@+id/artIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_music"
                                android:tint="#FFFFFFFF" />

                            <ImageView
                                android:id="@+id/albumArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/trackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:tag="a1"
                                android:textColor="@color/text_main"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/trackArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:tag="a2"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/prev"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_prev"
                            android:tag="a1"
                            android:tint="@color/text_main" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/play_pause"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play"
                            android:tag="a1"
                            android:tint="@color/text_main" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/next"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_next"
                            android:tag="a1"
                            android:tint="@color/text_main" />

                        <com.juandiego.priuslauncher.ProgressLine
                            android:id="@+id/progress"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/gap"
                    android:layout_weight="1"
                    android:background="@drawable/float_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/navLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/card_nav"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Mapa chico en vivo -->
                    <FrameLayout
                        android:id="@+id/mapCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/map_bg">

                        <FrameLayout
                            android:id="@+id/mapContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/mapWaiting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:tag="a2"
                            android:text="@string/gps_searching"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/navPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_margin="6dp"
                            android:background="@drawable/nav_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/navIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_turn"
                                android:tint="#FFFFFFFF" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/navTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/navText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="#CCFFFFFF"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:id="@+id/mapBorder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dockBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/d_h"
            android:background="@color/dock_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="22dp" />
    </LinearLayout>
</FrameLayout>
