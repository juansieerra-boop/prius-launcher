<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio estilo Apple (CarPlay).
     Izquierda: barra con la hora, Wi-Fi/BT y las apps (ZLink, Mapas, Música, Teléfono y las tuyas).
     Centro: el carro con la carretera HUD y la velocidad grande.
     Derecha: Navegación (mapa), Música y Clima. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/cp_pad">

        <!-- ===== Barra lateral ===== -->
        <LinearLayout
            android:id="@+id/sideBar"
            android:layout_width="@dimen/cp_side"
            android:layout_height="match_parent"
            android:background="@drawable/cp_side"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextClock
                android:id="@+id/clockTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:textColor="@color/cp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/statusWifi"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/chip_bg"
                    android:contentDescription="@string/wifi"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wifi" />

                <ImageButton
                    android:id="@+id/statusBt"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/chip_bg"
                    android:contentDescription="@string/bluetooth"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bt" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:fadingEdgeLength="16dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sideApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </ScrollView>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/d_settings"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"
                android:tint="@color/cp_muted" />

            <ImageButton
                android:id="@+id/btnApps"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/d_apps"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_g_grid"
                android:tint="@color/cp_text" />
        </LinearLayout>

        <!-- ===== El carro ===== -->
        <FrameLayout
            android:id="@+id/carCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cp_pad"
            android:layout_weight="510"
            android:background="@drawable/cp_panel">

            <com.juandiego.priuslauncher.CarPhotoView
                android:id="@+id/carPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:longClickable="true" />

            <LinearLayout
                android:id="@+id/speedRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="14dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="@color/cp_text"
                    android:textSize="@dimen/cp_speed" />

                <TextView
                    android:id="@+id/speedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/unit_mph_small"
                    android:textColor="@color/cp_muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gpsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_bg"
                    android:padding="6dp"
                    android:text="@string/gps_short"
                    android:textColor="@color/cp_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/gpsDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnDayNight"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="@drawable/chip_bg"
                    android:contentDescription="@string/day_night"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sun"
                    android:tint="@color/cp_muted" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Derecha ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cp_pad"
            android:layout_weight="404"
            android:orientation="vertical">

            <!-- Navegación -->
            <FrameLayout
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="326"
                android:background="@color/map_bg">

                <FrameLayout
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/mapWaiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/gps_searching"
                    android:textColor="@color/cp_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/navChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/cp_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/navChipIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_g_nav" />

                    <TextView
                        android:id="@+id/navLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_nav"
                        android:textColor="@color/cp_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/cp_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/navIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_turn"
                        android:tint="@color/cp_text" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/navTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="200dp"
                            android:singleLine="true"
                            android:textColor="@color/cp_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/navText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="200dp"
                            android:singleLine="true"
                            android:textColor="@color/cp_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/cp_pad"
                android:layout_weight="234"
                android:orientation="horizontal">

                <!-- Música -->
                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="200"
                    android:background="@drawable/cp_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/musicBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:padding="3dp"
                            android:src="@drawable/ic_g_music" />

                        <TextView
                            android:id="@+id/mediaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/d_music"
                            android:textColor="@color/cp_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/artBox"
                            android:layout_width="@dimen/cp_art"
                            android:layout_height="@dimen/cp_art">

                            <ImageView
                                android:id="@+id/artIcon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_g_music" />

                            <ImageView
                                android:id="@+id/albumArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/trackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/cp_text"
                                android:textSize="@dimen/cp_title"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trackArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/cp_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/prev"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_prev"
                            android:tint="@color/cp_text" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/play_pause"
                            android:padding="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play"
                            android:tint="@color/cp_text" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/chip_bg"
                            android:contentDescription="@string/next"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_next"
                            android:tint="@color/cp_text" />
                    </LinearLayout>

                    <com.juandiego.priuslauncher.ProgressLine
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Clima -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/cp_pad"
                    android:layout_weight="192"
                    android:background="@drawable/cp_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/weatherBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:padding="4dp"
                            android:src="@drawable/ic_sun" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/card_weather"
                            android:textColor="@color/cp_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/cp_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="@color/cp_text"
                            android:textSize="@dimen/cp_temp" />

                        <ImageView
                            android:id="@+id/weatherIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sun" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/cp_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/cp_muted"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/cp_line" />

                    <LinearLayout
                        android:id="@+id/weatherHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
