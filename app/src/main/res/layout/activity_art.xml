<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo ART: tu carro a la izquierda y el mapa grande a la derecha -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Izquierda: nombre, clima, velocidad y carro -->
            <RelativeLayout
                android:id="@+id/leftPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="436">

                <TextView
                    android:id="@+id/carName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/pad"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.14"
                    android:singleLine="true"
                    android:text="@string/brand_title"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/gpsPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/carName"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/carName"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/gpsDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/circle_bg" />

                    <TextView
                        android:id="@+id/gpsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weatherBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="@dimen/pad"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sun"
                        android:tint="@color/sun" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="@color/text_main"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="170dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="@string/weather_loading"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/speedBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/carName"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/speed_art" />

                    <TextView
                        android:id="@+id/speedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.25"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.juandiego.priuslauncher.CarPhotoView
                    android:id="@+id/carPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentBottom="true"
                    android:layout_below="@id/speedBlock"
                    android:layout_marginBottom="6dp"
                    android:longClickable="true" />
            </RelativeLayout>

            <!-- Derecha: mapa con tarjetas encima -->
            <FrameLayout
                android:id="@+id/mapPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="588">

                <FrameLayout
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnNavigate"
                        android:layout_width="@dimen/card_w"
                        android:layout_height="42dp"
                        android:background="@drawable/float_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            android:tint="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/navigate"
                            android:textColor="@color/text_muted"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnDayNight"
                        style="@style/IconBtn"
                        android:contentDescription="@string/day_night"
                        android:src="@drawable/ic_sun"
                        android:tint="@color/icon_tint" />

                    <ImageButton
                        android:id="@+id/btnAndroid"
                        style="@style/IconBtn"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/android_settings"
                        android:src="@drawable/ic_gear"
                        android:tint="@color/icon_tint" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        style="@style/IconBtn"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/settings_title"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/icon_tint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navPanel"
                    android:layout_width="@dimen/card_w"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="62dp"
                    android:background="@drawable/float_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/navIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_turn"
                        android:tint="@color/text_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/navTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/text_main"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/navText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/navSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:maxWidth="90dp"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="@dimen/card_w"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/float_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <FrameLayout
                        android:id="@+id/artBox"
                        android:layout_width="@dimen/art_size"
                        android:layout_height="@dimen/art_size">

                        <ImageView
                            android:id="@+id/artIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music"
                            android:tint="#FFFFFFFF" />

                        <ImageView
                            android:id="@+id/albumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/trackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/text_main"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/trackArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <com.juandiego.priuslauncher.ProgressLine
                            android:id="@+id/progress"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnPrev"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_bg"
                                android:contentDescription="@string/prev"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_prev"
                                android:tint="@color/text_main" />

                            <ImageButton
                                android:id="@+id/btnPlay"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="18dp"
                                android:layout_marginEnd="18dp"
                                android:background="@drawable/chip_bg"
                                android:contentDescription="@string/play_pause"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                android:tint="@color/text_main" />

                            <ImageButton
                                android:id="@+id/btnNext"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_bg"
                                android:contentDescription="@string/next"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_next"
                                android:tint="@color/text_main" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_h"
            android:background="@color/dock_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp" />
    </LinearLayout>
</FrameLayout>
