<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dock_gap"
    android:paddingEnd="@dimen/dock_gap">

    <FrameLayout
        android:id="@+id/iconBox"
        android:layout_width="@dimen/dock_box"
        android:layout_height="@dimen/dock_box"
        android:background="@drawable/card_bg"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dock_icon"
            android:layout_height="@dimen/dock_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/text_main" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:textColor="@color/text_soft"
        android:textSize="@dimen/dock_label" />
</LinearLayout>
