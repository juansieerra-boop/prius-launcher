<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta grande: degradado grafito + textura de fibra de carbono + borde fino -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="300"
                android:endColor="@color/card_bottom"
                android:startColor="@color/card_top" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/carbon_tile"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</layer-list>
